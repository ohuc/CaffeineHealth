*.keystore
*.p12
*.pfx
*.pem
*.key
*.env
.env.*
/key.properties
/signing.properties
/local-signing.properties
# Google Cloud OAuth client downloads; the app identifies itself by package + SHA-1 and needs none.
client_secret*.json
google-services.json

