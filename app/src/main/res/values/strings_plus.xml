    <string name="plus_feature_coach">Caffeine Coach</string>
    <string name="plus_feature_coach_body">Get a personalized suggestion for when to have caffeine and how much, using your recent intake and sleep schedule. Coach is included in Caffeine Health+ on Google Play.</string>
