    <string name="plus_feature_health">Health Connect</string>
    <string name="plus_feature_health_body">Write caffeine and hydration, and read sleep and external caffeine records with your permission.</string>
    <string name="plus_feature_automation">Automated logging</string>
    <string name="plus_feature_automation_body">Log drinks through Tasker, MacroDroid and NFC. Automation stays off until you enable it.</string>
