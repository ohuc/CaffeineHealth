<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Only the actual shared health/preferences DataStore is portable.
         Room and future Play billing/preview/identity files are not included. -->
    <cloud-backup>
        <include domain="file" path="datastore/user_settings.preferences_pb" />
    </cloud-backup>

    <device-transfer>
        <include domain="file" path="datastore/user_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
